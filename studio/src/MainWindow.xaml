<Window x:Class="AnyPS5Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AnyPS5 Studio" Width="1040" Height="720" MinWidth="820" MinHeight="560"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        Icon="pack://application:,,,/app.ico"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        Drop="OnDrop" DragOver="OnDragOver" Closing="OnClosing" SourceInitialized="OnSourceInitialized">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="264"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Library -->
    <Border Background="{StaticResource Side}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <Grid Margin="14,18,14,14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="AnyPS5 Studio" FontSize="19" FontWeight="SemiBold" Margin="10,0,0,16"/>
        <Button Grid.Row="1" x:Name="NewButton" Content="Convert a game" Style="{StaticResource PrimaryButton}" Click="OnNewClicked"/>
        <TextBlock Grid.Row="2" Text="Your games" Style="{StaticResource MutedText}" FontSize="12" Margin="10,20,0,6"/>
        <Grid Grid.Row="3">
          <TextBlock x:Name="EmptyLibrary" Style="{StaticResource MutedText}" Margin="10,4,10,0" FontSize="13"
                     Text="Games you convert show up here."/>
          <ListBox x:Name="GameList" Background="Transparent" BorderThickness="0" Padding="0"
                   ItemContainerStyle="{StaticResource GameItem}" SelectionChanged="OnGameSelected"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                  <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" FontSize="12"
                             TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
        <Border Grid.Row="4" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="10,12,4,0" Margin="0,10,0,0">
          <StackPanel>
            <TextBlock x:Name="EngineStatus" FontSize="12" Style="{StaticResource MutedText}"/>
            <Button x:Name="EngineButton" Content="Choose AnyPS5 folder" Margin="0,8,0,0" FontSize="12"
                    MinHeight="28" Padding="10,3" HorizontalAlignment="Left" Click="OnChooseEngine"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- Convert -->
    <ScrollViewer Grid.Column="1" x:Name="ConvertView" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="32,26,32,24" MaxWidth="760">
        <TextBlock Text="Convert a game" FontSize="26" FontWeight="SemiBold"/>
        <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,20"
                   Text="Point this at a decrypted PS5 game folder or .exfat image. You get a Windows program you can play from here."/>

        <Border Style="{StaticResource CardBorder}">
          <StackPanel>
            <TextBlock Text="Game folder" Style="{StaticResource SectionLabel}"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="SourceBox" Style="{StaticResource PathBox}" Tag="Game folder"/>
              <Button Grid.Column="1" x:Name="BrowseSource" Content="Folder" Margin="8,0,0,0" Click="OnBrowseSource"/>
              <Button Grid.Column="2" x:Name="BrowseImage" Content="Image file" Margin="8,0,0,0" Click="OnBrowseImage"/>
            </Grid>
            <TextBlock x:Name="ScanHint" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0"
                       Text="Or drop a folder or .exfat image anywhere on this window."/>

            <StackPanel x:Name="ScanPanel" Visibility="Collapsed" Margin="0,14,0,0">
              <TextBlock x:Name="GameTitle" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock x:Name="GameFacts" Style="{StaticResource MutedText}" Margin="0,3,0,0" FontSize="13"/>
              <StackPanel x:Name="ProblemList" Margin="0,8,0,0"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}">
          <StackPanel>
            <TextBlock Text="Save to" Style="{StaticResource SectionLabel}"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="OutputBox" Style="{StaticResource PathBox}" Tag="Save folder"/>
              <Button Grid.Column="1" x:Name="BrowseOutput" Content="Change" Margin="8,0,0,0" Click="OnBrowseOutput"/>
            </Grid>
            <TextBlock x:Name="OutputFacts" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
          <Button x:Name="ConvertButton" Content="Convert" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="OnConvert"/>
          <Button x:Name="CancelButton" Content="Cancel" Margin="8,0,0,0" Visibility="Collapsed" Click="OnCancel"/>
        </StackPanel>

        <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,0,0,12">
          <TextBlock x:Name="StageText" Margin="0,0,0,6"/>
          <ProgressBar x:Name="Progress" Maximum="1"/>
        </StackPanel>

        <Border x:Name="ResultBanner" Visibility="Collapsed" CornerRadius="8" BorderThickness="1" Padding="14,10" Margin="0,0,0,12">
          <TextBlock x:Name="ResultText"/>
        </Border>

        <StackPanel x:Name="ConvertFindings" Visibility="Collapsed" Margin="0,0,0,12">
          <StackPanel x:Name="ConvertFindingList"/>
          <Button x:Name="ConvertRecordButton" Content="Open conversion record" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnOpenConvertRecord"/>
        </StackPanel>

        <Expander x:Name="LogExpander" Header="Details" Foreground="{StaticResource Muted}" Visibility="Collapsed">
          <TextBox x:Name="ConvertLog" Style="{StaticResource LogBox}" Height="220" Margin="0,8,0,0"/>
        </Expander>
      </StackPanel>
    </ScrollViewer>

    <!-- One game -->
    <ScrollViewer Grid.Column="1" x:Name="GameView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="32,26,32,24" MaxWidth="760">
        <TextBlock x:Name="DetailTitle" FontSize="26" FontWeight="SemiBold"/>
        <TextBlock x:Name="DetailFacts" Style="{StaticResource MutedText}" Margin="0,4,0,18"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
          <Button x:Name="PlayButton" Content="Play" Style="{StaticResource PrimaryButton}" Click="OnPlay"/>
          <Button x:Name="StopButton" Content="Stop" Margin="8,0,0,0" Visibility="Collapsed" Click="OnStop"/>
          <Button x:Name="ShaderToggleButton" Margin="8,0,0,0" Visibility="Collapsed" Click="OnToggleShader"/>
          <Button x:Name="OpenButton" Content="Open folder" Margin="8,0,0,0" Click="OnOpenFolder"/>
          <Button x:Name="RemoveButton" Content="Remove from list" Margin="8,0,0,0" Click="OnRemove"/>
        </StackPanel>

        <TextBlock x:Name="RunStatus" Style="{StaticResource MutedText}" Margin="0,0,0,12" Visibility="Collapsed"/>

        <Border Style="{StaticResource CardBorder}">
          <StackPanel>
            <TextBlock Text="Diagnostics" Style="{StaticResource SectionLabel}"/>
            <CheckBox x:Name="DetailedCheck" Foreground="{StaticResource Text}" Margin="0,2,0,2"
                      Content="Detailed recording: shows which shaders cost the most, and can lower FPS slightly"
                      Checked="OnDetailedChanged" Unchecked="OnDetailedChanged"/>
            <CheckBox x:Name="TestModeCheck" Foreground="{StaticResource Text}" Margin="0,6,0,2"
                      Content="Test mode: skip this game's heaviest shader. The picture may look wrong"
                      Checked="OnTestModeChanged" Unchecked="OnTestModeChanged"/>
            <TextBlock Text="Engine switches" Style="{StaticResource MutedText}" FontSize="12" Margin="0,10,0,4"/>
            <TextBox x:Name="SwitchesBox" Style="{StaticResource PathBox}" IsReadOnly="False" Tag="Engine switches" LostFocus="OnSwitchesChanged"/>
            <TextBlock x:Name="SwitchesNote" Foreground="{StaticResource Warn}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

            <TextBlock x:Name="NoRunsText" Style="{StaticResource MutedText}" FontSize="13" Margin="0,12,0,0"
                       Text="Press Play and a report on the run appears here when the game closes."/>
            <StackPanel x:Name="RunPanel" Visibility="Collapsed" Margin="0,12,0,0">
              <TextBlock Text="Run" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,4"/>
              <ListBox x:Name="RunPicker" Background="Transparent" BorderThickness="0" Padding="0" MaxHeight="124"
                       ItemContainerStyle="{StaticResource GameItem}" DisplayMemberPath="Label" SelectionChanged="OnRunPicked"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
              <TextBlock x:Name="RunNumbers" Style="{StaticResource MutedText}" FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap"/>
              <TextBlock x:Name="RunComparison" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"/>
              <StackPanel x:Name="RunFindings" Margin="0,4,0,0"/>
              <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="OpenReportButton" Content="Open full report" Click="OnOpenReport"/>
                <Button x:Name="OpenRunButton" Content="Open run folder" Margin="8,0,0,0" Click="OnOpenRunFolder"/>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}">
          <StackPanel>
            <TextBlock Text="Game output" Style="{StaticResource SectionLabel}"/>
            <TextBox x:Name="RunLog" Style="{StaticResource LogBox}" Height="260"/>
          </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource MutedText}" FontSize="12"
                   Text="Converted games run with your full account access and no sandbox. Only play games you trust."/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
